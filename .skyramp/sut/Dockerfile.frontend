# Testbot SUT image for the wger-react frontend (Vite dev server).
# Build context MUST be the repository root (docker compose --project-directory .).
FROM node:22-slim

ENV NODE_ENV=development

WORKDIR /app

RUN apt-get update \
    && apt-get install --no-install-recommends -y curl \
    && rm -rf /var/lib/apt/lists/*

COPY wger-react/package.json wger-react/package-lock.json ./
RUN npm ci

COPY wger-react/ /app/

EXPOSE 3000

CMD ["npm", "start", "--", "--host", "0.0.0.0", "--port", "3000"]
